# SecureDNS Manager - backend environment
# Copy to backend/.env and adjust. ALL values below are dev defaults.

# Database: SQLite (default) or PostgreSQL, e.g.
# DATABASE_URL=postgresql+psycopg://securedns:CHANGE_ME@127.0.0.1:5432/secure_dns
DATABASE_URL=sqlite:///./secure_dns.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-insecure-secret-key-change-me

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty, a random key is generated at startup (tokens encrypted with it are lost on restart).
FERNET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
LOGIN_ATTEMPT_LIMIT=5
LOGIN_LOCKOUT_MINUTES=15

# Bootstrap admin created on first startup only
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe_Now_123!
ADMIN_EMAIL=admin@example.com

# Dev CORS origins (comma separated); production is same-origin
CORS_ORIGINS=http://localhost:5173

# Set true only when running without nginx in front
DEBUG=false