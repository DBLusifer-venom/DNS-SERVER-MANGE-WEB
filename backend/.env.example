# SecureDNS Manager - backend environment
# Copy to backend/.env and adjust. ALL values below are dev defaults.

# development | production
# In production, startup FAILS unless SECRET_KEY, FERNET_KEY, ADMIN_PASSWORD
# and DNS_MANAGEMENT_NETWORKS are all set to real values.
ENVIRONMENT=development

# Database: SQLite (default) or PostgreSQL, e.g.
# DATABASE_URL=postgresql+psycopg://securedns:CHANGE_ME@127.0.0.1:5432/secure_dns
DATABASE_URL=sqlite:///./secure_dns.db

# REQUIRED (no default). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# REQUIRED. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty in development, an ephemeral key is generated at startup and
# previously encrypted TSIG secrets become undecryptable on restart.
FERNET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
LOGIN_ATTEMPT_LIMIT=5
LOGIN_LOCKOUT_MINUTES=15

# REQUIRED: bootstrap admin password, created on first startup only.
# Must be strong and unique; startup refuses known placeholder values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com

# Dev CORS origins (comma separated); production is same-origin
CORS_ORIGINS=http://localhost:5173

# REQUIRED in production: CIDR allowlist of networks where DNS servers live.
# Every registered server's resolved IPs must fall inside one of these.
# Example: DNS_MANAGEMENT_NETWORKS=10.10.0.0/16,192.168.50.0/24
DNS_MANAGEMENT_NETWORKS=127.0.0.0/8,::1/128

# Refresh-token cookie flags. Secure=true (default) required in production.
COOKIE_SECURE=true

# Set true only when running without nginx in front
DEBUG=false